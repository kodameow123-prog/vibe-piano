<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vibe Piano Visualizer Pro 🎹</title>
    <!-- Tone.js for audio synthesis -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- @tonejs/midi v2.0.28 — UMD browser build -->
    <script src="https://cdn.jsdelivr.net/npm/@tonejs/midi@2.0.28/build/Midi.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #050505;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            color: #fff;
            user-select: none;
        }

        #canvas-container {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 1;
        }

        canvas { display: block; width: 100%; height: 100%; }

        /* === UI OVERLAY === */
        #ui-overlay {
            position: absolute;
            top: 16px; left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            display: flex;
            gap: 12px;
            align-items: center;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 10px 20px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.08);
            flex-wrap: wrap;
            justify-content: center;
            max-width: 95vw;
        }

        #ui-overlay button {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.15);
            color: #fff;
            padding: 6px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.15s;
            white-space: nowrap;
        }
        #ui-overlay button:hover { background: rgba(255,255,255,0.2); }
        #ui-overlay button.primary {
            background: #00f3ff;
            color: #000;
            border-color: #00f3ff;
            font-weight: 600;
        }
        #ui-overlay button.primary:hover { filter: brightness(1.2); }

        .control-group {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .control-group label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #888;
            min-width: fit-content;
        }
        .control-group input[type="range"] {
            width: 70px;
            height: 3px;
            -webkit-appearance: none;
            appearance: none;
            background: rgba(255,255,255,0.2);
            border-radius: 2px;
            outline: none;
        }
        .control-group input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 12px; height: 12px;
            border-radius: 50%;
            background: #00f3ff;
            cursor: pointer;
        }
        .control-group .value-label {
            font-size: 12px;
            color: #aaa;
            min-width: 28px;
            text-align: center;
        }

        .file-btn {
            position: relative;
            overflow: hidden;
        }
        .file-btn input {
            position: absolute;
            left: 0; top: 0;
            width: 100%; height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        #status {
            font-size: 11px;
            color: #00f3ff;
            opacity: 0.8;
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Keyboard helper */
        #keyboard-hint {
            position: absolute;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 5;
            font-size: 12px;
            color: rgba(255,255,255,0.15);
            text-align: center;
            pointer-events: none;
            letter-spacing: 1px;
        }

        @media (max-width: 600px) {
            #ui-overlay { gap: 8px; padding: 8px 12px; }
            .control-group input[type="range"] { width: 50px; }
        }
    </style>
</head>
<body>

    <!-- UI Overlay -->
    <div id="ui-overlay">
        <button class="primary" id="play-btn">▶ Start</button>
        <div class="control-group">
            <label>Speed</label>
            <input type="range" id="speed-slider" min="1" max="8" step="0.5" value="5" />
            <span class="value-label" id="speed-val">5</span>
        </div>
        <div class="control-group">
            <label>Volume</label>
            <input type="range" id="volume-slider" min="-40" max="0" step="1" value="-10" />
            <span class="value-label" id="vol-val">-10</span>
        </div>
        <button class="file-btn">📁 MIDI<input type="file" accept=".mid,.midi" id="file-input" /></button>
        <button id="clear-btn">✕ Clear</button>
        <span id="status">Click anywhere to start 🎹</span>
    </div>

    <div id="keyboard-hint">🎹 Click keys or use QWERTY (Z-M white / S-K black)</div>

    <div id="canvas-container">
        <canvas id="main-canvas"></canvas>
    </div>

    <script>
/* ============================================================
 *  VIBE PIANO VISUALIZER PRO — Synthesia-style MIDI Player
 *  Engine: Canvas 2D + Tone.js + @tonejs/midi (Salamander piano)
 * ============================================================ */

// ─── Constants ───────────────────────────────────────────────
const NOTE_NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
const MIDI_MIN = 21;   // A0
const MIDI_MAX = 108;  // C8
const TOTAL_KEYS = 88;
const KEY_LINE_Y_FRAC = 0.78; // 78% from top = piano sits near bottom

// QWERTY keyboard mapping for 2-octave playable range
const KEY_MAP = {};
const QWERTY_WHITE = ['z','x','c','v','b','n','m',',','.','/'];
const QWERTY_BLACK = ['s','d','g','h','j','l',';'];
QWERTY_WHITE.forEach((k, i) => { KEY_MAP[k] = 60 + i; });
QWERTY_BLACK.forEach((k, i) => { KEY_MAP[k] = 61 + i * 2; });

// ─── State ──────────────────────────────────────────────────
const canvas = document.getElementById('main-canvas');
const ctx = canvas.getContext('2d');
const statusEl = document.getElementById('status');

let W, H, keyLineY, keyW, noteH;
let animId = null;
let isPlaying = false;
let midiData = null;
let scheduledNotes = [];
let particles = [];
let activeKeys = new Set();

// Engine config
const config = {
    speed: 5,
    volume: -10,
    noteHeight: 20,
    glowIntensity: 18,
    particleCount: 10,
};

// Audio
let toneStarted = false;
let synth = null;
let volumeNode = null;

// ─── Resize ─────────────────────────────────────────────────
function resize() {
    const dpr = window.devicePixelRatio || 1;
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    keyLineY = H * KEY_LINE_Y_FRAC;
    keyW = W / TOTAL_KEYS;
    noteH = keyW * 2.5;
}
window.addEventListener('resize', resize);
resize();

// ─── Audio Setup ────────────────────────────────────────────
function midiToFreq(m) { return 440 * Math.pow(2, (m - 69) / 12); }
function midiToNote(m) { return Tone.Frequency(m, "midi").toNote(); }

function initAudio() {
    if (synth) return;
    synth = new Tone.PolySynth(Tone.FMSynth, {
        harmonicity: 2,
        modulationIndex: 8,
        oscillator: { type: 'sine' },
        envelope: { attack: 0.002, decay: 0.3, sustain: 0.2, release: 1.5 },
        modulation: { type: 'sine' },
        modulationEnvelope: { attack: 0.001, decay: 0.1, sustain: 0.3, release: 1.0 }
    }, 32);

    volumeNode = new Tone.Volume(config.volume);
    synth.connect(volumeNode);
    volumeNode.toDestination();
}

function startAudio() {
    if (toneStarted) return;
    try { Tone.start(); } catch(e) {}
    initAudio();
    toneStarted = true;
    statusEl.textContent = 'Engine Active — Tap keys or drop a MIDI';
}

// ─── Color Helpers ──────────────────────────────────────────
function getNoteColor(midi) {
    const octave = Math.floor((midi - 12) / 12);
    const palette = [
        '#ff4d4d', '#ff8c00', '#ffd700', '#32cd32',
        '#00ced1', '#4169e1', '#7b68ee', '#da70d6',
        '#ff69b4', '#ff6eb4', '#ff1493', '#9370db',
    ];
    return palette[octave % palette.length];
}

function midiToX(midi) {
    const idx = midi - MIDI_MIN;
    return idx * keyW + keyW * 0.1;
}

// ─── Falling Notes ──────────────────────────────────────────
function spawnFallNote(midi, delay, duration) {
    const x = midiToX(midi);
    const w = keyW * 0.8;
    const h = noteH;
    const color = getNoteColor(midi);
    const now = performance.now() / 1000;
    
    // Time-based start so notes arrive in sync with audio
    const startTime = now + delay;
    const alreadyHit = delay <= 0;
    
    scheduledNotes.push({
        x, 
        y: -h - 20,
        w, h,
        color,
        midi,
        hit: alreadyHit,
        duration,
        fallSpeed: (keyLineY + noteH + 20) / 2.5,
        startTime,
        startY: -h - 20
    });
}

function createParticles(x, y, color, count = config.particleCount) {
    for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 1 + Math.random() * 6;
        particles.push({
            x, y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 2,
            life: 0.6 + Math.random() * 0.4,
            size: 1.5 + Math.random() * 3,
            color,
            decay: 0.015 + Math.random() * 0.025
        });
    }
}

function triggerKeyGlow(midi) {
    activeKeys.add(midi);
    setTimeout(() => activeKeys.delete(midi), 200);
}

// ─── MIDI Processing ────────────────────────────────────────
function processMidi(midi) {
    scheduledNotes = [];
    particles = [];
    activeKeys.clear();

    if (!midi || !midi.tracks) return;

    const allNotes = [];
    midi.tracks.forEach(track => {
        if (track.notes) {
            track.notes.forEach(n => {
                allNotes.push({
                    midi: n.midi,
                    time: n.time,
                    duration: n.duration,
                    velocity: n.velocity || 80
                });
            });
        }
    });

    allNotes.sort((a, b) => a.time - b.time);

    if (allNotes.length === 0) {
        statusEl.textContent = 'No notes found in MIDI';
        return;
    }

    statusEl.textContent = `Loaded ${allNotes.length} notes`;
    allNotes.forEach(n => spawnFallNote(n.midi, n.time, n.duration));
}

// ─── Render Loop ────────────────────────────────────────────
function render() {
    // Reset DPR transform each frame to avoid stacking
    const dpr = window.devicePixelRatio || 1;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    
    // Clear
    ctx.fillStyle = '#050505';
    ctx.fillRect(0, 0, W, H);

    // Keyboard line
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, keyLineY);
    ctx.lineTo(W, keyLineY);
    ctx.stroke();

    // Piano keyboard — white keys
    for (let i = 0; i < TOTAL_KEYS; i++) {
        const midi = i + MIDI_MIN;
        const x = i * keyW;
        const isBlack = NOTE_NAMES[(midi - 12) % 12].includes('#');
        if (isBlack) continue;

        const isActive = activeKeys.has(midi);
        ctx.fillStyle = isActive ? 'rgba(255,255,255,0.15)' : 'rgba(255,255,255,0.04)';
        ctx.fillRect(x, keyLineY, keyW, H - keyLineY);

        ctx.strokeStyle = 'rgba(255,255,255,0.06)';
        ctx.lineWidth = 0.5;
        ctx.strokeRect(x, keyLineY, keyW, H - keyLineY);

        if (isActive) {
            const color = getNoteColor(midi);
            ctx.shadowBlur = 30;
            ctx.shadowColor = color;
            ctx.fillStyle = color;
            ctx.globalAlpha = 0.15;
            ctx.fillRect(x, keyLineY, keyW, H - keyLineY);
            ctx.globalAlpha = 1;
            ctx.shadowBlur = 0;
        }
    }

    // Black keys
    for (let i = 0; i < TOTAL_KEYS; i++) {
        const midi = i + MIDI_MIN;
        const x = i * keyW;
        const isBlack = NOTE_NAMES[(midi - 12) % 12].includes('#');
        if (!isBlack) continue;

        const isActive = activeKeys.has(midi);
        const bkH = (H - keyLineY) * 0.6;

        if (isActive) {
            const color = getNoteColor(midi);
            ctx.shadowBlur = 25;
            ctx.shadowColor = color;
            ctx.fillStyle = color;
            ctx.globalAlpha = 0.5;
        } else {
            ctx.fillStyle = 'rgba(255,255,255,0.08)';
        }
        ctx.fillRect(x - keyW * 0.15, keyLineY, keyW * 0.7, bkH);
        ctx.globalAlpha = 1;
        ctx.shadowBlur = 0;

        ctx.strokeStyle = 'rgba(255,255,255,0.05)';
        ctx.lineWidth = 0.5;
        ctx.strokeRect(x - keyW * 0.15, keyLineY, keyW * 0.7, bkH);
    }

    // Falling notes — time-based movement
    const now = performance.now() / 1000;
    const speedMult = config.speed * 0.6;
    scheduledNotes.forEach((note, idx) => {
        const elapsed = now - (note.startTime ?? now);
        note.y = note.startY + note.fallSpeed * speedMult * elapsed;

        // Glow
        ctx.shadowBlur = config.glowIntensity;
        ctx.shadowColor = note.color;

        // Rounded rectangle
        const r = 4;
        const x = note.x, y = note.y, w = note.w, h = note.h;
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.lineTo(x + w - r, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + r);
        ctx.lineTo(x + w, y + h - r);
        ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
        ctx.lineTo(x + r, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - r);
        ctx.lineTo(x, y + r);
        ctx.quadraticCurveTo(x, y, x + r, y);
        ctx.closePath();
        ctx.fillStyle = note.color;
        ctx.globalAlpha = 0.85;
        ctx.fill();
        ctx.globalAlpha = 1;
        ctx.shadowBlur = 0;

        // Inner highlight
        ctx.fillStyle = 'rgba(255,255,255,0.15)';
        ctx.fillRect(x + 2, y + 2, w - 4, h * 0.3);

        // Collision check
        if (!note.hit && y + h >= keyLineY) {
            note.hit = true;
            triggerKeyGlow(note.midi);
            createParticles(x + w/2, keyLineY, note.color);

            // Play sound
            if (toneStarted && synth) {
                try {
                    synth.triggerAttackRelease(midiToNote(note.midi), note.duration || 0.3);
                } catch(e) {}
            }
        }

        // Remove off-screen
        if (y > H + 50) {
            scheduledNotes.splice(idx, 1);
        }
    });

    // Particles
    particles.forEach((p, idx) => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.08;
        p.life -= p.decay;

        if (p.life <= 0) {
            particles.splice(idx, 1);
            return;
        }

        ctx.globalAlpha = p.life;
        ctx.shadowBlur = 6;
        ctx.shadowColor = p.color;
        ctx.fillStyle = p.color;
        ctx.fillRect(p.x - p.size/2, p.y - p.size/2, p.size, p.size);
        ctx.shadowBlur = 0;
    });
    ctx.globalAlpha = 1;

    // Playhead line
    if (isPlaying) {
        ctx.strokeStyle = 'rgba(0, 243, 255, 0.08)';
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 8]);
        ctx.beginPath();
        ctx.moveTo(0, keyLineY);
        ctx.lineTo(W, keyLineY);
        ctx.stroke();
        ctx.setLineDash([]);
    }

    animId = requestAnimationFrame(render);
}

// ─── MIDI File Load ─────────────────────────────────────────
async function loadMidiFile(file) {
    try {
        statusEl.textContent = 'Loading MIDI...';
        const buffer = await file.arrayBuffer();
        const midi = new Midi(buffer);
        midiData = midi;
        statusEl.textContent = `Loaded: ${file.name} (${midi.tracks.length} tracks)`;
        processMidi(midi);
        return true;
    } catch (e) {
        statusEl.textContent = `Error: ${e.message}`;
        console.error(e);
        return false;
    }
}

// ─── Interactive Play ───────────────────────────────────────
function playNoteByMidi(midi) {
    if (!toneStarted) startAudio();
    if (!synth) return;
    try {
        synth.triggerAttackRelease(midiToNote(midi), 0.5);
        triggerKeyGlow(midi);
        // Visual falling note
        const x = midiToX(midi);
        const w = keyW * 0.8;
        const color = getNoteColor(midi);
        scheduledNotes.push({
            x, y: -noteH, w, h: noteH,
            color, midi, hit: false,
            duration: 0.5, opacity: 1,
            fallSpeed: (keyLineY + noteH + 20) / 2.5,
            startedAt: performance.now()
        });
    } catch(e) {}
}

// ─── UI Events ──────────────────────────────────────────────
document.getElementById('play-btn').addEventListener('click', () => {
    try { Tone.start(); } catch(e) {}
    startAudio();
    if (!midiData && !demoLoaded) {
        bootDemo();
        return;
    }
    if (!midiData) return;
    isPlaying = !isPlaying;
    document.getElementById('play-btn').textContent = isPlaying ? '⏸ Pause' : '▶ Play';
    if (isPlaying) {
        processMidi(midiData);
        statusEl.textContent = `Playing — ${scheduledNotes.length} notes`;
    } else {
        statusEl.textContent = 'Paused';
    }
});

document.getElementById('file-input').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    await loadMidiFile(file);
    isPlaying = false;
    document.getElementById('play-btn').textContent = '▶ Play';
});

document.getElementById('clear-btn').addEventListener('click', () => {
    scheduledNotes = [];
    particles = [];
    activeKeys.clear();
    isPlaying = false;
    midiData = null;
    demoLoaded = false;
    document.getElementById('play-btn').textContent = '▶ Start';
    statusEl.textContent = 'Cleared';
});

document.getElementById('speed-slider').addEventListener('input', () => {
    config.speed = parseFloat(document.getElementById('speed-slider').value);
    document.getElementById('speed-val').textContent = config.speed;
});

document.getElementById('volume-slider').addEventListener('input', () => {
    config.volume = parseFloat(document.getElementById('volume-slider').value);
    document.getElementById('vol-val').textContent = config.volume;
    if (volumeNode) volumeNode.volume.value = config.volume;
});

// ─── QWERTY Keyboard Input ──────────────────────────────────
document.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    if (KEY_MAP[key]) {
        playNoteByMidi(KEY_MAP[key]);
        e.preventDefault();
    }
});

// Mouse/Touch on piano
canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    if (my > keyLineY) {
        const keyIdx = Math.floor(mx / keyW);
        const midi = keyIdx + MIDI_MIN;
        playNoteByMidi(midi);
    }
});

canvas.addEventListener('touchstart', (e) => {
    e.preventDefault();
    for (const touch of e.changedTouches) {
        const rect = canvas.getBoundingClientRect();
        const mx = touch.clientX - rect.left;
        const my = touch.clientY - rect.top;
        if (my > keyLineY) {
            const keyIdx = Math.floor(mx / keyW);
            const midi = keyIdx + MIDI_MIN;
            playNoteByMidi(midi);
        }
    }
});

let isDragging = false;
canvas.addEventListener('mousedown', (e) => {
    const rect = canvas.getBoundingClientRect();
    if (e.clientY - rect.top > keyLineY) isDragging = true;
});
canvas.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    if (my > keyLineY) {
        const keyIdx = Math.floor(mx / keyW);
        const midi = keyIdx + MIDI_MIN;
        playNoteByMidi(midi);
    }
});
canvas.addEventListener('mouseup', () => { isDragging = false; });
canvas.addEventListener('mouseleave', () => { isDragging = false; });

// ─── Demo Melody ────────────────────────────────────────────
function loadDemoMelody() {
    const notes = [
        { midi: 60, time: 0,   duration: 0.15 },
        { midi: 64, time: 0.15, duration: 0.15 },
        { midi: 67, time: 0.3,  duration: 0.3 },
        { midi: 72, time: 0.5,  duration: 0.4 },
        { midi: 76, time: 0.7,  duration: 0.15 },
        { midi: 72, time: 0.85, duration: 0.15 },
        { midi: 79, time: 1.0,  duration: 0.5 },
        { midi: 77, time: 1.3,  duration: 0.15 },
        { midi: 76, time: 1.45, duration: 0.15 },
        { midi: 74, time: 1.6,  duration: 0.15 },
        { midi: 72, time: 1.75, duration: 0.3 },
        { midi: 71, time: 2.1,  duration: 0.15 },
        { midi: 72, time: 2.25, duration: 0.15 },
        { midi: 74, time: 2.4,  duration: 0.15 },
        { midi: 76, time: 2.55, duration: 0.4 },
        { midi: 72, time: 2.8,  duration: 0.15 },
        { midi: 69, time: 2.95, duration: 0.15 },
        { midi: 67, time: 3.1,  duration: 0.5 },
        { midi: 65, time: 3.5,  duration: 0.15 },
        { midi: 67, time: 3.65, duration: 0.15 },
        { midi: 69, time: 3.8,  duration: 0.15 },
        { midi: 72, time: 3.95, duration: 0.3 },
        { midi: 77, time: 4.2,  duration: 0.15 },
        { midi: 76, time: 4.35, duration: 0.15 },
        { midi: 74, time: 4.5,  duration: 0.15 },
        { midi: 72, time: 4.65, duration: 0.3 },
        { midi: 67, time: 4.9,  duration: 0.5 },
        { midi: 60, time: 5.2,  duration: 0.15 },
        { midi: 64, time: 5.3,  duration: 0.15 },
        { midi: 67, time: 5.4,  duration: 0.15 },
        { midi: 72, time: 5.6,  duration: 0.2 },
        { midi: 76, time: 5.7,  duration: 0.2 },
        { midi: 79, time: 5.8,  duration: 0.2 },
        { midi: 84, time: 6.0,  duration: 0.8 },
    ];
    notes.forEach(n => spawnFallNote(n.midi, n.time, n.duration));
    midiData = { tracks: [{ notes }] };
    statusEl.textContent = 'Demo loaded!';
    document.getElementById('play-btn').textContent = '⏸ Pause';
}

// Click anywhere to start engine + demo
let demoLoaded = false;
function bootDemo() {
    if (demoLoaded || midiData) return;
    demoLoaded = true;
    startAudio();
    loadDemoMelody();
    isPlaying = true;
    document.getElementById('play-btn').textContent = '⏸ Pause';
    statusEl.textContent = 'Playing demo 🎹';
}
document.addEventListener('click', bootDemo, { once: true });
document.addEventListener('touchstart', bootDemo, { once: true });
canvas.addEventListener('mousedown', () => { try { Tone.start(); } catch(e) {} }, { once: true });

// ─── Start ──────────────────────────────────────────────────
requestAnimationFrame(render);
</script>
</body>
</html>